{
  "name": "obs-helper",
  "version": "0.1.0",
  "private": true,
  "description": "OBS Helper - 스트리밍 도우미 서비스",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:widgets": "pnpm --filter widgets dev",
    "build": "pnpm --recursive build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:widgets": "pnpm --filter widgets build",
    "test": "pnpm --recursive test",
    "test:cov": "pnpm --recursive test:cov",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm --recursive clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
